{
  "name": "knowledge-quiz",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "stack": "bash scripts/stack.sh",
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest --coverage",
    "test:acceptance": "bash scripts/test-acceptance.sh",
    "lint": "expo lint",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --config .prettierrc.js '**/*.{js,jsx,ts,tsx}' --check",
    "prettier": "prettier --config .prettierrc.js '**/*.{js,jsx,ts,tsx}' --write",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "jest-junit": "^17.0.0",
    "prettier": "^3.8.0",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "tar": "^7.5.3"
  },
  "private": true
}
